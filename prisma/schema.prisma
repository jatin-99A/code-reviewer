generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model checking {
  id    String @id @default(cuid())
  title String
}

// Authentication schemas
model User {
  id                 String              @id
  name               String
  email              String
  emailVerified      Boolean             @default(false)
  image              String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  sessions           Session[]
  accounts           Account[]
  githubInstallation GithubInstallation?

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// Github Installation
enum GithubInstallationStatus {
  ACTIVE
  PENDING_DELETE
  DELETE_FAILED
}

model GithubInstallation {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  installationId Int                      @unique
  status         GithubInstallationStatus @default(ACTIVE)

  accountLogin String
  accountType  String
  permissions  Json

  rateLimitTotal     Int?
  rateLimitRemaining Int?

  repositories Repository[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([installationId], map: "idx_installation_github_id")
  @@index([userId], map: "idx_installation_user")
  @@map("github_installation")
}

// Repositories 
enum RepositoryHealthStatus {
  HEALTHY
  WARNING
  CRITICAL
}

model Repository {
  id String @id @default(cuid())

  installationId String
  installation   GithubInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)

  githubRepoId BigInt @unique

  name        String
  description String?
  mainBranch  String

  healthScore  Int
  healthStatus RepositoryHealthStatus

  language String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  pullRequests PullRequest[]
  aiIssues     AIIssue[]
  analytics    DailyAnalytics[]

  @@index([githubRepoId], map: "idx_repo_github_id")
  @@index([installationId], map: "idx_repo_installation")
  @@map("repositories")
}

// Pull Requests
enum PullRequestStatus {
  OPEN
  MERGED
  IN_REVIEW
  APPROVED
}

model PullRequest {
  id String @id @default(cuid())

  repositoryId String
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  githubPrId BigInt @unique

  prNumber Int

  title String

  branchName String

  status PullRequestStatus

  aiScore Int?

  linesAdded   Int?
  linesDeleted Int?

  openedBy String

  githubCreatedAt DateTime

  updatedAt DateTime @updatedAt

  issues AIIssue[]

  @@index([repositoryId, status], map: "idx_pr_repo_status")
  @@index([githubPrId], map: "idx_pr_github_id")
  @@map("pull_requests")
}

// AI Issues
enum AIIssueSeverity {
  CRITICAL
  WARNING
  NOTICE
}

enum AIIssueStatus {
  OPEN
  RESOLVED
}

model AIIssue {
  id String @id @default(cuid())

  pullRequestId String
  pullRequest   PullRequest @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)

  repositoryId String
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  title String

  severity AIIssueSeverity

  filePath String

  lineNumber Int

  status AIIssueStatus

  createdAt DateTime @default(now())

  @@index([pullRequestId], map: "idx_issues_pr")
  @@index([repositoryId, severity], map: "idx_issues_repo_severity")
  @@map("ai_issues")
}

// Daily Analytics
model DailyAnalytics {
  id Int @id @default(autoincrement())

  repositoryId String
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  logDate DateTime @db.Date

  reviewsCount Int

  issuesCount Int

  @@unique([repositoryId, logDate], map: "idx_analytics_repo_date")
  @@map("daily_analytics")
}
